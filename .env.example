# Google Cloud project used to run query jobs (must have billing enabled)
GOOGLE_CLOUD_PROJECT=your-query-project-id
BIGQUERY_LOCATION=US

# Hard ceiling for bytes billed per query. Start small.
MAX_BYTES_BILLED=100000000
QUERY_TIMEOUT_SECONDS=30
MAX_RESULT_ROWS=100

# Business timezone for relative date resolution (IANA name)
BUSINESS_TIMEZONE=America/Los_Angeles

# Set to false to skip live INFORMATION_SCHEMA and use static schema
LIVE_SCHEMA=true

# Optional OpenAI-compatible LLM endpoint. Leave unset to use deterministic demo mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
